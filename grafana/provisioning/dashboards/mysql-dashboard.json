{
  "dashboard": {
    "title": "MySQL Monitoring Dashboard",
    "tags": ["mysql", "database"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "MySQL Active Connections",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "mysql_global_status_threads_connected",
            "legendFormat": "Active Connections"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Connections"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "MySQL Queries per Minute",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(mysql_global_status_queries[1m]) * 60",
            "legendFormat": "Queries/min"
          },
          {
            "expr": "rate(mysql_global_status_com_select[1m]) * 60",
            "legendFormat": "SELECT/min"
          },
          {
            "expr": "rate(mysql_global_status_com_insert[1m]) * 60",
            "legendFormat": "INSERT/min"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Queries"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "MySQL Database Load",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "mysql_global_status_threads_running",
            "legendFormat": "Running Threads"
          },
          {
            "expr": "mysql_global_status_threads_connected",
            "legendFormat": "Connected Threads"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Threads"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "MySQL Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "mysql_up",
            "legendFormat": "MySQL Status"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          }
        }
      }
    ]
  }
}

